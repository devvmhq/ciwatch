#!/usr/bin/env bash
# Starts a factory workflow for a dex task, in the background, from the current
# branch of the project you run it in (unpushed commits included).
#
#   factory feature <dex-id> [extra `archon workflow run` flags]
#   factory fix <dex-id> [extra `archon workflow run` flags]
#
# It prints Archon's JSON acknowledgement, which holds the run ID. Follow the
# run with `archon workflow logs <run> --follow`, answer its approvals with
# `archon workflow approve <run> "comment"` or `archon workflow reject <run>
# "reason"`, and read its state with `archon workflow get <run> --json`.
set -euo pipefail

usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

[ $# -ge 2 ] || usage
workflow=$1 task=$2
shift 2
case $workflow in feature | fix) ;; *) usage ;; esac
[[ $task =~ ^[a-z0-9]+$ ]] || { echo "not a dex task ID: '$task'" >&2; exit 2; }

branch=$(git branch --show-current)
[ -n "$branch" ] || { echo "factory: check out a branch first (HEAD is detached)" >&2; exit 2; }

exec archon workflow run "$workflow" --from "$branch" --input task="$task" --detach --json "$@" \
  "$workflow dex task $task"
